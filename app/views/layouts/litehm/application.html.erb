<!doctype html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · LiteHM" : "LiteHM" %></title>
    <link rel="icon" type="image/png" href="<%= icon_path %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <noscript><meta http-equiv="refresh" content="5"></noscript>
    <%= csrf_meta_tags %>
    <%= tag.style nonce: content_security_policy_nonce do %>
      :root {
        color-scheme: light dark;
        --bg: #f6f5f1; --surface: #fff; --surface-2: #f1efea; --text: #1e1f1d; --muted: #6a6a64;
        --faint: #a3a29b; --line: #e5e2da; --link: #1f5fbf;
        --info: #2563eb; --info-soft: #e8effd; --success: #3f8f3a; --success-soft: #e9f4e6;
        --attention: #b7791f; --attention-soft: #fdf3e1; --warning: #c2410c; --warning-soft: #fdece3;
        --danger: #c62828; --danger-soft: #fdeaea; --muted-tone: #6b7280; --muted-soft: #eeeeec;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 15px; line-height: 1.5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #111312; --surface: #191b1a; --surface-2: #202321; --text: #ecebe6; --muted: #9d9c95;
          --faint: #5f615c; --line: #2b2e2c; --link: #8ab4ff;
          --info: #6ea0ff; --info-soft: #1a2540; --success: #7cc774; --success-soft: #1b2b1a;
          --attention: #f0b95a; --attention-soft: #33280f; --warning: #fb923c; --warning-soft: #3a2113;
          --danger: #f87171; --danger-soft: #3b1717; --muted-tone: #9ca3af; --muted-soft: #262826;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); }
      main { max-width: 960px; margin: 0 auto; padding: 28px 28px 72px; }
      a { color: var(--link); text-decoration: none; } a:hover { text-decoration: underline; }
      .mono, code, pre { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.88em; }
      .top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
      .brand { color: var(--text); font-weight: 700; font-size: 17px; letter-spacing: -0.01em; }
      .brand:hover { text-decoration: none; }
      .meta { color: var(--muted); font-size: 13px; display: flex; gap: 14px; align-items: center; }
      .live::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--success); }
      .tone-info { --tone: var(--info); --tone-soft: var(--info-soft); }
      .tone-success { --tone: var(--success); --tone-soft: var(--success-soft); }
      .tone-attention { --tone: var(--attention); --tone-soft: var(--attention-soft); }
      .tone-warning { --tone: var(--warning); --tone-soft: var(--warning-soft); }
      .tone-danger { --tone: var(--danger); --tone-soft: var(--danger-soft); }
      .tone-muted { --tone: var(--muted-tone); --tone-soft: var(--muted-soft); }
      .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--tone);
        background: var(--tone-soft); border-radius: 999px; padding: 3px 10px 3px 8px; white-space: nowrap; }
      .chip::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--tone); }
      .counts { font-size: 15px; color: var(--muted); margin: 0 0 18px; }
      .counts .attn { color: var(--attention); font-weight: 600; }
      .section { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; margin: 26px 0 10px; }
      .op, .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; }
      .op { padding: 14px 20px 12px; margin-bottom: 10px; }
      .op-head { display: flex; justify-content: space-between; gap: 16px; align-items: center; }
      .op-title { font-size: 16px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
      .op-sub { color: var(--muted); font-size: 12.5px; margin-top: 2px; overflow-wrap: anywhere; }
      .op-sub .tbl { color: var(--text); font-weight: 500; }
      .op-body { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 28px; align-items: center; }
      .op-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
      .op-now { color: var(--muted); font-size: 13.5px; font-variant-numeric: tabular-nums; }
      .op.finished { padding: 10px 20px; }
      .op.finished .op-title { font-size: 14.5px; font-weight: 500; }
      .op-right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
      .rail { display: flex; list-style: none; padding: 0; margin: 12px 0 2px; }
      .rail li { flex: 1; position: relative; text-align: center; font-size: 12px; color: var(--faint); }
      .rail li::after { content: ""; position: absolute; top: 9px; left: calc(50% + 13px); right: calc(-50% + 13px); height: 2px; border-radius: 2px;
        background: linear-gradient(to right, var(--fill-color, var(--success)) var(--fill, 0%), var(--line) var(--fill, 0%)); }
      .rail li:last-child::after { display: none; }
      .rail li.current { --fill-color: var(--info); } .rail li.paused { --fill-color: var(--muted-tone); } .rail li.failed { --fill-color: var(--danger); }
      .dot { width: 20px; height: 20px; border-radius: 50%; margin: 0 auto 6px; display: grid; place-items: center; font-size: 11px; font-weight: 700;
        border: 2px solid var(--line); background: var(--surface); color: #fff; position: relative; z-index: 1; }
      .rail .label { display: block; font-weight: 500; }
      .rail .sub { display: block; font-size: 11.5px; color: var(--muted); min-height: 15px; }
      .rail li.done { color: var(--muted); }
      .rail li.done .dot { background: var(--success); border-color: var(--success); }
      .rail li.done .dot::before { content: "✓"; }
      .rail li:is(.current, .waiting, .failed, .stalled, .paused, .hold, .stopped) { color: var(--text); }
      .rail li:is(.current, .waiting, .failed, .stalled, .paused, .stopped) .label { font-weight: 700; }
      .rail li.current .dot { border-color: var(--info); box-shadow: 0 0 0 4px var(--info-soft); }
      .rail li.current .dot::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--info); }
      .rail li.waiting .dot { border-color: var(--attention); background: var(--attention); box-shadow: 0 0 0 4px var(--attention-soft); }
      .rail li.waiting .dot::before { content: "…"; line-height: 0; margin-top: -5px; }
      .rail li.hold .dot { border-color: var(--success); border-style: dashed; }
      .rail li.paused .dot, .rail li.stopped .dot { border-color: var(--muted-tone); background: var(--muted-tone); }
      .rail li.paused .dot::before { content: "❚❚"; font-size: 7px; letter-spacing: -1px; }
      .rail li.stopped .dot::before { content: "■"; font-size: 8px; }
      .rail li.failed .dot { border-color: var(--danger); background: var(--danger); box-shadow: 0 0 0 4px var(--danger-soft); }
      .rail li.failed .dot::before { content: "✕"; }
      .rail li.stalled .dot { border-color: var(--warning); background: var(--warning); box-shadow: 0 0 0 4px var(--warning-soft); }
      .rail li.stalled .dot::before { content: "!"; }
      .rail li.current .sub { color: var(--info); font-weight: 600; }
      .rail li.waiting .sub { color: var(--attention); font-weight: 600; }
      .rail li.failed .sub { color: var(--danger); font-weight: 600; }
      .rail li.stalled .sub { color: var(--warning); font-weight: 600; }
      form.action { display: inline; margin: 0; }
      button { font: inherit; font-size: 13.5px; font-weight: 600; border-radius: 9px; padding: 6px 13px; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--text); white-space: nowrap; }
      button:hover { border-color: var(--faint); }
      button.primary { background: var(--text); color: var(--bg); border-color: var(--text); }
      button.danger, button.primary.danger { color: var(--danger); background: transparent; border-color: color-mix(in srgb, var(--danger) 45%, transparent); }
      button.danger:hover { background: var(--danger-soft); border-color: var(--danger); }
      .back { display: inline-block; font-size: 14px; margin-bottom: 12px; }
      .dhead { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
      .eyebrow { color: var(--muted); font-size: 13.5px; overflow-wrap: anywhere; } .eyebrow b { color: var(--text); font-weight: 600; }
      h1 { font-size: 24px; letter-spacing: -0.02em; margin: 2px 0 8px; line-height: 1.25; }
      .status { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 14px; font-variant-numeric: tabular-nums; }
      .dactions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
      .card { padding: 18px 22px; margin-top: 16px; }
      .card .rail { margin: 4px 0 0; }
      .card .rail li { font-size: 13px; }
      .card .dot { width: 26px; height: 26px; font-size: 13px; }
      .card .rail li::after { top: 12px; left: calc(50% + 16px); right: calc(-50% + 16px); height: 3px; }
      .card .rail .sub { font-size: 12px; }
      .problem { margin-top: 16px; border-radius: 12px; padding: 10px 14px; background: var(--tone-soft); font-size: 14px; }
      .problem p { margin: 0; color: var(--tone); font-weight: 600; }
      .problem details { margin-top: 6px; font-size: 12.5px; color: var(--muted); }
      .problem summary { cursor: pointer; }
      .problem pre, .problem dl { margin: 6px 0 0; padding: 10px; border-radius: 8px; background: var(--surface); white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px; }
      .metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
      .group h3 { margin: 0 0 6px; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); font-weight: 600; }
      .group h3 span { text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--faint); margin-left: 4px; }
      dl { margin: 0; }
      dl div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; }
      dl div:last-child { border-bottom: 0; }
      dt { color: var(--muted); white-space: nowrap; }
      dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
      .empty { color: var(--muted); }
      @media (max-width: 760px) {
        main { padding: 18px 14px 60px; }
        .op-body, .metrics { grid-template-columns: 1fr; gap: 8px; }
        .op-side { align-items: flex-start; text-align: left; }
        .dhead { flex-direction: column; align-items: flex-start; } .dactions { justify-content: flex-start; }
        .rail .label { font-size: 11px; }
      }
    <% end %>
  </head>
  <body>
    <main>
      <header class="top">
        <%= link_to "LiteHM", operations_path, class: "brand" %>
        <span class="meta"><span>queue <span class="mono"><%= LiteHM.configuration.queue_name %></span></span><span class="live"><%= (@now || Time.now.utc).strftime("%H:%M:%S UTC") %></span></span>
      </header>
      <%= yield %>
    </main>
    <%= javascript_tag nonce: true do %>
      (function () {
        var submitting = false;
        document.addEventListener("submit", function (event) {
          var message = event.target.getAttribute("data-litehm-confirm");
          if (message && !window.confirm(message)) { event.preventDefault(); return; }
          submitting = true;
        });
        // Refresh every 5 s, except during a submit, in a hidden tab, or with details open.
        setInterval(function () {
          if (submitting || document.hidden || document.querySelector("details[open]")) return;
          window.location.reload();
        }, 5000);
      })();
    <% end %>
  </body>
</html>
