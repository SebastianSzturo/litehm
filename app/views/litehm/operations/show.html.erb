<% summary = @summary %>
<% status = @operation %>
<% metrics = summary.worker_metrics %>
<% content_for :title, status.table %>
<%= link_to "← Operations", operations_path, class: "back" %>

<div class="dhead">
  <div>
    <div class="eyebrow"><b><%= status.table %></b> · <span class="mono"><%= status.plan_id %></span></div>
    <h1><%= summary.change_summary %></h1>
    <div class="status"><%= litehm_chip(summary) %><span><%= summary.header_line %></span></div>
  </div>
  <div class="dactions">
    <% summary.ordered_actions.each do |command| %>
      <%= litehm_action_button(summary, command, primary: command == summary.primary_action) %>
    <% end %>
  </div>
</div>

<% if summary.state == :failed %>
  <div class="problem tone-danger">
    <p><%= summary.error_line %></p>
    <details><summary>Error details</summary><pre><%= JSON.pretty_generate(status.error) %></pre></details>
  </div>
<% elsif summary.state == :stalled %>
  <div class="problem tone-warning">
    <p><%= summary.stalled_line %></p>
    <details><summary>Details</summary>
      <dl>
        <div><dt>Last commit</dt><dd><%= litehm_time(summary.last_activity) %></dd></div>
        <div><dt>Re-enqueued by RecoveryJob</dt><dd><%= litehm_time(status.recovery_enqueued_at) %></dd></div>
      </dl>
    </details>
  </div>
<% end %>

<section class="card"><%= render "track", summary:, detailed: true %></section>

<section class="card metrics">
  <div class="group">
    <% if summary.finished? %>
      <h3>Result</h3>
      <dl>
        <div><dt>Rows copied</dt><dd><%= number_with_delimiter(summary.copied_rows) %></dd></div>
        <div><dt>Cut over</dt><dd><%= litehm_time(summary.cutover_time) %></dd></div>
        <div><dt>Old table</dt><dd><%= litehm_archive_state(status) %></dd></div>
        <div><dt>Updated</dt><dd><%= litehm_time(status.updated_at) %></dd></div>
      </dl>
    <% else %>
      <h3>Progress</h3>
      <dl>
        <div><dt>Rows copied</dt><dd><%= number_with_delimiter(summary.copied_rows) %></dd></div>
        <div><dt>Total</dt><dd><%= summary.total_rows ? "#{"~" if summary.total_estimated?}#{number_with_delimiter(summary.total_rows)}" : "—" %></dd></div>
        <div><dt>Copied</dt><dd><%= summary.percent ? "#{summary.percent}%" : "—" %></dd></div>
        <div><dt>Rate</dt><dd><%= summary.copy_rate ? "#{number_with_delimiter(summary.copy_rate.round)}/s" : "—" %></dd></div>
        <div><dt>ETA</dt><dd><%= summary.eta_at ? litehm_clock(summary.eta_at, now: @now) : "—" %></dd></div>
        <div><dt>Pending changes</dt><dd><%= litehm_dirty_rows(status) %></dd></div>
        <div><dt>Last commit</dt><dd><%= litehm_ago(summary, status.last_advanced_at) %></dd></div>
      </dl>
    <% end %>
  </div>

  <div class="group">
    <% if metrics.empty? %>
      <h3>Worker</h3>
      <p class="empty">No worker metrics yet.</p>
    <% else %>
      <% batch = metrics["last_batch"] || {} %>
      <% checkpoint = metrics["checkpoint"] || {} %>
      <h3>Worker <span>sampled <%= litehm_ago(summary, metrics["sampled_at"]) %></span></h3>
      <dl>
        <div><dt>Stage</dt><dd><%= litehm_stage(metrics["stage"]) %></dd></div>
        <div><dt>Last txn</dt><dd><%= litehm_metric(batch["transaction_ms"], unit: "ms") %><%= " · rolled back" if batch["committed"] == false %></dd></div>
        <div><dt>Max txn</dt><dd><%= litehm_metric(summary.max_transaction_ms, unit: "ms") %></dd></div>
        <div><dt>Next batch</dt><dd><%= batch["next_rows"] ? "#{number_with_delimiter(batch["next_rows"])} rows" : "—" %></dd></div>
        <div><dt>Lock wait</dt><dd><%= litehm_metric(metrics["lock_wait_ms"], unit: "ms") %></dd></div>
        <div><dt>Retries / rollbacks</dt><dd><%= number_with_delimiter(metrics["lock_retries"].to_i) %> / <%= number_with_delimiter(metrics["rollbacks"].to_i) %></dd></div>
        <div><dt>WAL pending</dt><dd><%= checkpoint["pending_frames"].nil? ? "—" : number_with_delimiter(checkpoint["pending_frames"]) %></dd></div>
        <% if (last_retry = metrics["last_retry"]) %>
          <div><dt>Last retry</dt><dd><%= litehm_reason(last_retry["reason"]) %></dd></div>
        <% end %>
      </dl>
    <% end %>
  </div>

  <div class="group">
    <h3>Plan</h3>
    <dl>
      <div><dt>Change</dt><dd><%= safe_join(summary.changes, tag.br).presence || "—" %></dd></div>
      <div><dt>Cutover</dt><dd><%= status.policy.to_h["cutover"] || "—" %></dd></div>
      <div><dt>Old table</dt><dd><%= { "retain" => "kept until released", "ephemeral" => "dropped at cutover" }.fetch(status.policy.to_h["archive"], "—") %></dd></div>
      <div><dt>Submitted</dt><dd><%= litehm_time(status.created_at) %></dd></div>
      <div><dt>Revision</dt><dd><%= number_with_delimiter(status.execution_revision) %></dd></div>
    </dl>
  </div>
</section>
