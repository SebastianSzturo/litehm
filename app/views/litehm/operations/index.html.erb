<% if @summaries.empty? %>
  <p class="counts">No LiteHM operations have been submitted.</p>
<% else %>
  <% active, finished = @summaries.partition { |summary| !summary.finished? } %>
  <p class="counts"><%= litehm_counts(@summaries) %></p>

  <% active.each do |summary| %>
    <article class="op">
      <div class="op-head">
        <div>
          <%= link_to summary.change_summary, operation_path(summary.plan_id), class: "op-title" %>
          <div class="op-sub"><span class="tbl"><%= summary.table %></span> · <span class="mono"><%= summary.plan_id %></span></div>
        </div>
        <%= litehm_chip(summary) %>
      </div>
      <div class="op-body">
        <%= render "track", summary:, detailed: false %>
        <div class="op-side">
          <span class="op-now"><%= summary.status_line %></span>
          <%= litehm_action_button(summary, summary.primary_action, primary: true) if summary.primary_action %>
        </div>
      </div>
    </article>
  <% end %>

  <% if finished.any? %>
    <h2 class="section">Done</h2>
    <% finished.each do |summary| %>
      <article class="op finished">
        <div class="op-head">
          <div>
            <%= link_to summary.change_summary, operation_path(summary.plan_id), class: "op-title" %>
            <div class="op-sub"><span class="tbl"><%= summary.table %></span> · <span class="mono"><%= summary.plan_id %></span></div>
          </div>
          <div class="op-right">
            <span class="op-now"><%= summary.status_line %></span>
            <%= litehm_action_button(summary, summary.primary_action, primary: true) if summary.primary_action %>
            <%= litehm_chip(summary) %>
          </div>
        </div>
      </article>
    <% end %>
  <% end %>
<% end %>
